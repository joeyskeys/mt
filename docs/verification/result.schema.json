{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mt Metal validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "device",
    "configuration",
    "checks",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_utc",
        "commit",
        "command",
        "status"
      ],
      "properties": {
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported",
            "not_run"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos",
        "name",
        "registry_id",
        "device_type",
        "unified_memory",
        "metal_family"
      ],
      "properties": {
        "macos": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "registry_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "device_type": {
          "type": "string",
          "minLength": 1
        },
        "unified_memory": {
          "type": "boolean"
        },
        "metal_family": {
          "type": "string",
          "minLength": 1
        },
        "os_build": {
          "type": "string"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xcode",
        "sdk",
        "swift",
        "build_type",
        "api_validation"
      ],
      "properties": {
        "xcode": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "string",
          "minLength": 1
        },
        "swift": {
          "type": "string",
          "minLength": 1
        },
        "build_type": {
          "enum": [
            "Debug",
            "Release",
            "RelWithDebInfo",
            "MinSizeRel",
            "unknown"
          ]
        },
        "api_validation": {
          "type": "boolean"
        },
        "gpu_capture": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported",
            "not_run"
          ]
        },
        "expected": {},
        "actual": {},
        "diagnostic": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "native_path",
        "fallback_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported",
            "not_run"
          ]
        },
        "native_path": {
          "type": "string"
        },
        "fallback_path": {
          "type": "string"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
